{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-ios": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {},
      "channel": "production-ios"
    },
    "production-tvos": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_TV": "1"
      },
      "ios": {},
      "channel": "production-tvos"
    },
    "production-android-apk": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "production-android-apk"
    },
    "production-google-play": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_TV": "1",
        "EXPO_KEEP_ADAPTIVE_ICON": "1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production-google-play"
    },
    "production-firetv": {
      "autoIncrement": true,
      "distribution": "internal",
      "env": {
        "EXPO_TV": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "production-firetv"
    }
  },
  "submit": {
    "production-ios": {
      "ios": {
        "ascAppId": "6833266123",
        "appleTeamId": "BNP9QFC679"
      }
    },
    "production-tvos": {
      "ios": {
        "ascAppId": "6833266123",
        "appleTeamId": "BNP9QFC679"
      }
    }
  }
}
