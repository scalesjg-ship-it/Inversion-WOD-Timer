{
  "expo": {
    "name": "Americana",
    "slug": "americana",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "americana",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.garrettscales.americana",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Americana uses your photo library so your gym logo can appear on the timer.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.garrettscales.americana",
      "adaptiveIcon": {
        "backgroundColor": "#07080A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#07080A",
          "imageWidth": 280
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Americana uses your photo library so your gym logo can appear on the timer.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/tv/android-tv-banner.png",
          "androidTVIcon": "./assets/tv/android-tv-icon.png",
          "appleTVImages": {
            "iconLayers": {
              "front": "./assets/tv/tvos-icon-front-1280x768.png",
              "back": "./assets/tv/tvos-icon-back-1280x768.png"
            },
            "iconSmallLayers": {
              "front": "./assets/tv/tvos-icon-front-400x240.png",
              "back": "./assets/tv/tvos-icon-back-400x240.png"
            },
            "iconSmall2xLayers": {
              "front": "./assets/tv/tvos-icon-front-800x480.png",
              "back": "./assets/tv/tvos-icon-back-800x480.png"
            },
            "topShelf": "./assets/tv/topshelf-1920x720.png",
            "topShelf2x": "./assets/tv/topshelf-3840x1440.png",
            "topShelfWide": "./assets/tv/topshelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/tv/topshelf-wide-4640x1440.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF4D2E",
          "sounds": [
            "./assets/sounds/start.wav",
            "./assets/sounds/warning.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/tick.wav"
          ],
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-4000-8000-000000000000"
      }
    }
  }
}
